#!/usr/bin/env node

import path from 'path';
import { fileURLToPath } from 'url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

if (process.argv.includes('--help')) {
  console.log('Usage: jevons [options]');
  console.log('');
  console.log('Options:');
  console.log('  --options     Start interactive configuration');
  console.log('  --help        Show help');
  process.exit(0);
}

const appRoot = path.resolve(__dirname, '..');
process.chdir(appRoot);

if (process.argv.includes('--options')) {
  const { runCLI } = await import('../app/cli.js');
  runCLI().catch(err => {
    console.error('CLI error:', err);
    process.exit(1);
  });
} else {
  const { startDiscordRuntime } = await import('../app/index.js');
  startDiscordRuntime().catch((err) => {
    console.error('Failed to start Discord runtime', err);
    process.exitCode = 1;
  });
}
